# Example settings file.
#
# Copy this file to `config.env` (gitignored) and fill in your values, or export
# the same variables in your shell or CI secrets. Environment variables take
# precedence over `config.env`; unset or empty values use the defaults below.
# All settings are read through `utils/config.py`.
#
#   cp config.env.example config.env

# --- Kaggle API credentials (required for dataset download) ---
# Create a token at https://www.kaggle.com/settings (Account -> API ->
# "Create New Token"). kagglehub also reads ~/.kaggle/kaggle.json if present.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Workspace paths (relative paths resolve against the repository root) ---
# Working outputs: optuna/, runs/, metrics/, figures/        (default: results)
BIORESERVOIR_RESULTS_DIR=
# Log files                                                  (default: logs)
BIORESERVOIR_LOGS_DIR=
# Frozen, read-only manuscript archives, archive/<version>/  (default: archive)
BIORESERVOIR_ARCHIVE_DIR=
