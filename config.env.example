# Example settings file.
#
# Copy this file to `config.env` (gitignored) and fill in your values, or export
# the same variables in your shell or CI secrets. Environment variables take
# precedence over `config.env`; unset or empty values use the defaults below.
# All settings are read through `utils/config.py`.
#
#   cp config.env.example config.env

# --- Kaggle API credentials (required for dataset download) ---
# Create a token at https://www.kaggle.com/settings (Account -> API ->
# "Create New Token"). kagglehub also reads ~/.kaggle/kaggle.json if present.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional folder that already holds mitbih_train.csv and mitbih_test.csv
KAGGLE_HEARTBEAT_DIR=

# --- Workspace paths (relative paths resolve against the repository root) ---
# Working outputs: optuna/, runs/, metrics/, figures/        (default: results)
BIORESERVOIR_RESULTS_DIR=
# Log files                                                  (default: logs)
BIORESERVOIR_LOGS_DIR=
# Datasets; the ECG files and caches live in <data>/ecg/     (default: data)
BIORESERVOIR_DATA_DIR=
# Frozen, read-only results of released versions, archive/<version>/ (default: archive)
# May live outside the repository.
BIORESERVOIR_ARCHIVE_DIR=

# --- Remote deployment (python -m optimization.deploy / optimization.collect) ---
# Each host needs RHEL 9 (or compatible) with Python 3.12, ssh and rsync, and
# key-based SSH login. Hosts are referred to by label everywhere else; runs record
# the label (not the address) as their machine label.
# Hosts as label=address pairs, e.g. host1=node1.example.org,host2=192.0.2.10
BIORESERVOIR_DEPLOY_HOSTS=
# SSH user (empty: use your SSH configuration)
BIORESERVOIR_DEPLOY_USER=
# Absolute remote workspace, at least two levels deep (deleted by --cleanup)
BIORESERVOIR_DEPLOY_WORKSPACE=
# Remote interpreter used to create the venv                (default: python3)
BIORESERVOIR_DEPLOY_PYTHON=
# Optional proxy for pip on the remote hosts
BIORESERVOIR_DEPLOY_PIP_PROXY=
# Optional systemd unit to stop during runs (restart with --start-service)
BIORESERVOIR_DEPLOY_SERVICE=

# --- Run metadata ---
# Optional label recorded with every trial run on this machine, e.g. host1
BIORESERVOIR_MACHINE_LABEL=
