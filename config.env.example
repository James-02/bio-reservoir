# Example environment configuration.
#
# Copy this file to `config.env` (which is gitignored) and fill in your values,
# or export these variables in your shell / CI secrets.
#
#   cp config.env.example config.env
#
# The MIT-BIH dataset is downloaded via `kagglehub`, which requires a Kaggle API
# token. Create one at https://www.kaggle.com/settings (Account -> API ->
# "Create New Token"). kagglehub also reads ~/.kaggle/kaggle.json if present.

# --- Kaggle API credentials (required for dataset download) ---
KAGGLE_USERNAME=
KAGGLE_KEY=
